# URL of the backend API worker this frontend proxies to.
# The web app is a pure proxy client: it never runs Better Auth or touches
# the database, so no auth secret or DB URL is needed here.
VITE_SERVER_URL=http://localhost:3000
# Optional. Digits of the WhatsApp Business line, used only for the post-signup wa.me link.
# Leave empty in the repository. Do not commit a real number.
VITE_WHATSAPP_BUSINESS_NUMBER=
