{
  "name": "server-hono",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "dev": "wrangler dev --port 3000 --inspector-port 9229",
    "deploy": "wrangler deploy",
    "cf:gen-types": "wrangler types --env-interface CloudflareBindings",
    "test:integration": "dotenvx run -f .env.test -- vitest run --config vitest.integration.config.ts",
    "test:integration:ci": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@emergency-map/application": "workspace:*",
    "@emergency-map/domain": "workspace:*",
    "@emergency-map/infra-auth": "workspace:*",
    "@emergency-map/infra-db": "workspace:*",
    "@emergency-map/infra-env": "workspace:*",
    "@emergency-map/infra-messaging": "workspace:*",
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "^0.45.1",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@emergency-map/config": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
