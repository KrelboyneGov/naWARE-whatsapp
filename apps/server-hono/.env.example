# Database
DATABASE_URL=
DATABASE_URL_DIRECT=

# Better-auth
# To set BETTER_AUTH_SECRET let's use = openssl rand -base64 32
BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=
CORS_ORIGIN=

# Public origin of the web app. Template example links and the signup prompt use it.
APP_PUBLIC_URL=http://localhost:3001

# Zavu. The project default sender is SMS-only. Every WhatsApp send uses this id
# in the Zavu-Sender header and channel=whatsapp. Sender "Achalau HCO".
ZAVUDEV_API_KEY=
ZAVU_SENDER_ID=kd7b3sknk6z3xvn5pykzgkc7a58ghwe7
# Per-sender secret from Senders > Achalau HCO > Webhooks (event message.inbound).
ZAVU_WEBHOOK_SECRET=
# Leave false until the sender reports canSendTemplates=true. A false value records
# template jobs as a terminal error and does not retry them.
ZAVU_CAN_SEND_TEMPLATES=false
# E.164 of the business line, used only to build the demo wa.me link. Do not commit a real number.
WHATSAPP_BUSINESS_NUMBER=

# 32-byte key, base64. openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
# Separate secret. Never reuse the encryption key.
PHONE_HASH_KEY=

# Optional. Without LLM_API_KEY the agent uses the deterministic composer.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional Atomic Memory (WhatsApp RECUERDA / QUÉ RECUERDAS / OLVIDA). Leave either empty to
# disable it; replies stay the same and nothing is stored. Cloud: https://api.atomicstrata.ai
# with a project key (amc_...) from the console. Local Core: http://127.0.0.1:17350 + CORE_API_KEY.
ATOMICMEMORY_API_URL=
ATOMICMEMORY_API_KEY=

DATA_RETENTION_DAYS=30
# Bearer token for POST /api/v1/internal/notifications/dispatch and /internal/agent/tools.
INTERNAL_JOB_TOKEN=

# Unverified. Shown in the welcome as "verificar antes de producción".
EMERGENCY_INDECI_NUMBER=119
EMERGENCY_FIRE_NUMBER=116
