{
  "name": "@emergency-map/application",
  "version": "1.0.0",
  "description": "Application layer — shared use cases for all server-side consumers (Elysia, TanStack serverFn, Astro, cron jobs)",
  "keywords": [
    "application",
    "server-only",
    "use-cases"
  ],
  "license": "ISC",
  "author": "",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./src/index.ts",
    "./events": "./src/events/index.ts",
    "./evidence": "./src/evidence/index.ts",
    "./help": "./src/help/index.ts",
    "./review": "./src/review/index.ts",
    "./sources": "./src/sources/index.ts",
    "./territory": "./src/territory/index.ts",
    "./todos": "./src/todos/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./events": "./dist/events.mjs",
      "./evidence": "./dist/evidence.mjs",
      "./help": "./dist/help.mjs",
      "./review": "./dist/review.mjs",
      "./sources": "./dist/sources.mjs",
      "./territory": "./dist/territory.mjs",
      "./todos": "./dist/todos.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev:watch": "tsdown --watch",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@emergency-map/domain": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
