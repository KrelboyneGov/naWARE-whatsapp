{
  "name": "@emergency-map/domain",
  "version": "1.0.0",
  "description": "Domain constants, types, and utilities for emergency-map",
  "keywords": [
    "constants",
    "domain",
    "types",
    "typescript"
  ],
  "license": "ISC",
  "author": "",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    "./constants": "./src/constants/index.ts",
    "./demo": "./src/demo/index.ts",
    "./repositories": "./src/repositories/index.ts",
    "./rules": "./src/rules/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./testing": "./src/testing/index.ts",
    "./types": "./src/types/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      "./constants": "./dist/constants.mjs",
      "./demo": "./dist/demo.mjs",
      "./repositories": "./dist/repositories.mjs",
      "./rules": "./dist/rules.mjs",
      "./schemas": "./dist/schemas.mjs",
      "./testing": "./dist/testing.mjs",
      "./types": "./dist/types.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev:watch": "tsdown --watch",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
